{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/kilo-auto/free",
  "default_agent": "code",
  "instructions": ["AGENTS.md"],
  "snapshot": true,
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "D:\\my project"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-git", "--repository", "D:\\my project"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-fetch"],
      "enabled": true
    },
    "time": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-time"],
      "enabled": true
    },
    "markitdown": {
      "type": "local",
      "command": ["npx", "-y", "@microsoft/markitdown-mcp"],
      "enabled": true
    },
    "wikipedia": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-wikipedia"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": ["npx", "-y", "duckduckgo-mcp-server"],
      "enabled": true
    },
    "arxiv": {
      "type": "local",
      "command": ["npx", "-y", "arxiv-mcp-server"],
      "enabled": true
    },
    "hackernews": {
      "type": "local",
      "command": ["npx", "-y", "hackernews-mcp"],
      "enabled": true
    },
    "youtube-transcript": {
      "type": "local",
      "command": ["npx", "-y", "youtube-transcript-mcp"],
      "enabled": true
    }
  }
}